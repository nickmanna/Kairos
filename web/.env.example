# A long random passcode. The web app asks for it once; the Mac widget sends it as a Bearer token.
KAIROS_TOKEN=
# Local dev only. Production uses Workload Identity Federation (see apphosting.yaml), no key.
# From console.anthropic.com → API Keys. Or leave empty and run `ant auth login` instead.
ANTHROPIC_API_KEY=
# Google Cloud → APIs & Services → Credentials → OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Filled in after visiting /api/google/connect once
GOOGLE_REFRESH_TOKEN=
# Optional
# CLAUDE_MODEL=claude-opus-5-5
# KAIROS_CALENDAR_NAME=Kairos Tasks
# KAIROS_TIMEZONE=America/Chicago
# PUBLIC_URL=https://kairos--your-project.us-central1.hosted.app
