# A long random passcode. The web app asks for it once; the Mac widget sends it as a Bearer token.
KAIROS_TOKEN=
# Claude credentials for local dev: an API key, or leave empty to use your `ant auth login` profile.
# In production the server uses Workload Identity Federation instead (see README).
ANTHROPIC_API_KEY=
# Google Cloud → APIs & Services → Credentials → OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Filled in after visiting /api/google/connect once
GOOGLE_REFRESH_TOKEN=
# Optional
# CLAUDE_MODEL=claude-haiku-5-5   # or claude-opus-5-5 for tougher phrasing
# KAIROS_CALENDAR_NAME=Kairos Tasks
# KAIROS_TIMEZONE=America/Chicago
# PUBLIC_URL=https://kairos--your-project.us-central1.hosted.app
